      "engine": "Redis",
      "version": "7.2.5",
      "cluster": "Redis Sentinel (3 nodes)",
      "eviction": "allkeys-lru"
    },
    "search": {
      "primary": "Elasticsearch 8.13.4",
      "fallback": "OpenSearch 2.14"
    },
    "object_storage": "AWS S3 + MinIO (on-prem)",
    "time_series": "TimescaleDB 2.15 (PostgreSQL extension)",
    "graph": "Neo4j 5.20 (supply chain graph)"
  },

  "messaging": {
    "primary": {
      "engine": "Apache Kafka",
      "version": "3.7.0",
      "brokers": 5,
      "replication_factor": 3,
      "retention_hours": 168
